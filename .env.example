# Copy to .env (git-ignored). Docker Compose reads it automatically.

# --- Gemini via Vertex AI (uses the Google Cloud credits) ---
GOOGLE_GENAI_USE_VERTEXAI=true
# Your GCP project ID, e.g. tectonic-kbc-123456
GOOGLE_CLOUD_PROJECT=
# Gemini 3.x models are only served from the global location
GOOGLE_CLOUD_LOCATION=global
# Service-account key: save the JSON as ./secrets/gcp-sa.json (git-ignored, mounted into the backend).
GEMINI_MODEL=gemini-3.8-flash

# --- Alternative: Gemini API key from AI Studio (leave empty when using Vertex) ---
GEMINI_API_KEY=

# --- Auth ---
# Random string of at least 32 characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Password shared by all demo accounts (advisor, sara, lien, ahmed, marc, julie, pieter, jan)
DEMO_PASSWORD=
# true only when served over HTTPS
COOKIE_SECURE=false

# --- Optional tuning (defaults in backend/app/config.py) ---
# Gemini thinking level: minimal | low | medium | high (empty = model default). See backend/evals/REPORT.md.
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=10
# Scale-view price assumptions in EUR per million tokens: check the Google Cloud price list.
PRICE_PER_MILLION_INPUT_TOKENS_EUR=0.30
PRICE_PER_MILLION_OUTPUT_TOKENS_EUR=2.50

# --- Evals only: Jev via OpenRouter's Decisions API (python -m evals.run --variants jev) ---
OPENROUTER_API_KEY=
