# Copy to .env (git-ignored). Docker Compose reads it automatically.

# --- Gemini via Vertex AI (uses the Google Cloud credits) ---
GOOGLE_GENAI_USE_VERTEXAI=true
# Your GCP project ID, e.g. tectonic-kbc-123456
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
# Service-account key: save the JSON as ./secrets/gcp-sa.json (git-ignored, mounted into the backend).
GEMINI_MODEL=gemini-2.5-flash

# --- Alternative: Gemini API key from AI Studio (leave empty when using Vertex) ---
GEMINI_API_KEY=

# --- Auth ---
# Random string of at least 32 characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Password shared by all demo accounts (advisor, sara, lien, ahmed, marc, julie, pieter, jan)
DEMO_PASSWORD=
# true only when served over HTTPS
COOKIE_SECURE=false
